---
import { Image } from 'astro:assets';
import galleryNewInterior from '../assets/images/gallery/gym-interior-new.jpg';
import galleryPersonalTraining from '../assets/images/gallery/garcia-personal-training.jpg';
import galleryCardio from '../assets/images/gallery/cardio-functional.jpg';
import gallerySession from '../assets/images/gallery/gym-training-session.jpg';
import galleryWeights from '../assets/images/gallery/gallery-weights.jpg';
import galleryReception from '../assets/images/gallery/garcia-reception.jpg';
import gallerySupplements from '../assets/images/gallery/gallery-supplements.jpg';
import galleryBrand from '../assets/images/gallery/garcia-brand.jpg';

const images = [
  { src: galleryNewInterior, alt: 'Piso de musculación y mancuernas con iluminación hexagonal en Voltag Gym', label: 'Zona Musculación Pro', class: 'gallery__item--wide' },
  { src: galleryPersonalTraining, alt: 'Entrenamiento guiado con entrenador certificado en Voltag Gym', label: 'Asesoría Personalizada', class: '' },
  { src: galleryCardio, alt: 'Zona de cardio y entrenamiento funcional', label: 'Cardio & Funcional', class: '' },
  { src: galleryWeights, alt: 'Rack profesional de mancuernas de alto impacto', label: 'Peso Libre', class: 'gallery__item--tall' },
  { src: galleryReception, alt: 'Área de recepción y atención a la comunidad Voltag', label: 'Instalaciones', class: '' },
  { src: gallerySession, alt: 'Sesión activa de entrenamiento en comunidad', label: 'Comunidad Voltag', class: '' },
  { src: gallerySupplements, alt: 'Estación de suplementos deportivos y bebidas energizantes', label: 'Suplementos', class: '' },
  { src: galleryBrand, alt: 'Espíritu y marca Voltag Gym en Manzanares Candelaria', label: 'Poder Voltag', class: 'gallery__item--wide' },
];
---

<section class="gallery" id="instalaciones">
  <div class="container">
    <div class="gallery__header reveal">
      <div class="section-badge">Instalaciones</div>
      <h2 class="section-title">Conoce Nuestro <span>Espacio</span></h2>
      <p class="section-subtitle">
        Dos pisos completamente equipados con maquinaria comercial, iluminación hexagonal, 
        zona de peso libre y el mejor ambiente del sector para alcanzar tus metas.
      </p>
    </div>

    <div class="gallery__grid reveal-stagger reveal">
      {images.map((img) => (
        <div class={`gallery__item ${img.class}`}>
          <Image
            src={img.src}
            alt={img.alt}
            width={600}
            height={400}
            quality={80}
            format="webp"
            class="gallery__img"
          />
          <div class="gallery__overlay"></div>
          <div class="gallery__label">{img.label}</div>
          <div class="gallery__corner"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery {
    background: var(--black-pure);
  }

  .gallery__header {
    margin-bottom: 48px;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 220px;
    gap: 8px;
  }

  .gallery__item {
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .gallery__item--wide {
    grid-column: span 2;
  }

  .gallery__item--tall {
    grid-row: span 2;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.7s var(--transition);
    filter: saturate(0.8) brightness(0.9);
  }

  .gallery__item:hover .gallery__img {
    transform: scale(1.08);
    filter: saturate(1.05) brightness(0.8);
  }

  .gallery__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5,5,5,0.75), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s;
  }

  .gallery__item:hover .gallery__overlay {
    opacity: 1;
  }

  .gallery__label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 14px 18px;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white);
    transform: translateY(100%);
    transition: transform 0.4s var(--transition);
    z-index: 2;
  }

  .gallery__item:hover .gallery__label {
    transform: translateY(0);
  }

  .gallery__corner {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 20px;
    height: 20px;
    border-top: 2px solid var(--red);
    border-right: 2px solid var(--red);
    opacity: 0;
    transition: opacity 0.4s, transform 0.4s;
    transform: translate(10px, -10px);
    z-index: 2;
  }

  .gallery__item:hover .gallery__corner {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (max-width: 900px) {
    .gallery__grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 200px;
    }

    .gallery__item--wide {
      grid-column: span 2;
    }

    .gallery__item--tall {
      grid-row: span 1;
    }

    .gallery__label {
      transform: translateY(0);
      font-size: 0.65rem;
    }

    .gallery__corner {
      opacity: 0.4;
      transform: translate(0, 0);
    }
  }

  @media (max-width: 500px) {
    .gallery__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 220px;
    }

    .gallery__item--wide {
      grid-column: span 1;
    }
  }
</style>
